# ==============================================================================
# AI NetController - Environment Configuration Template
# Copy to .env for local development. Never commit real secrets or tokens.
# ==============================================================================

# --- AI Providers ---
# Google Gemini API key (used by apps/web/server.ts /api/chat and /api/ai/models/test)
GEMINI_API_KEY=
# Optional local Ollama endpoint override (default: http://127.0.0.1:11434)
OLLAMA_HOST=

# --- Web Server & Localhost-First Binding ---
# Set to production when serving prebuilt apps/web/dist assets (`npm start`)
NODE_ENV=development
# Localhost-first binding by default; keep 127.0.0.1 unless exposing on a trusted LAN
HOST=127.0.0.1
PORT=3000
# Set ALLOW_LAN_WEB=true only on trusted private LANs (binds 0.0.0.0 when HOST is unset)
ALLOW_LAN_WEB=false
# Comma-separated explicit origins permitted for CORS when ALLOW_LAN_WEB=true
ALLOWED_ORIGINS=
# Optional bearer secret protecting /api/* web control routes
WEB_CONTROL_SECRET=

# --- Host Agent Daemon & Crypto Pairing ---
# Shared PSK used for HMAC/X25519 pairing between client and Python Host Agent.
# Generate a random 48-char hex secret via:
#   openssl rand -hex 24
#   python -c "import secrets; print(secrets.token_hex(24))"
AI_AGENT_SECRET=
# Legacy alias checked if AI_AGENT_SECRET is unset (prefer AI_AGENT_SECRET)
CST_AGENT_SECRET=
# Host Agent WebSocket port (default: 8765)
AI_AGENT_PORT=8765
# Optional TLS certificate/key paths for wss:// transport
AI_TLS_CERT=
AI_TLS_KEY=

# --- Release Publishing (CI / Maintainer Only) ---
GITHUB_TOKEN=
GITLAB_TOKEN=

# --- Android Build & Release Signing ---
ANDROID_HOME=
JAVA_HOME=
# Release keystore path (used by scripts/build_android_app.py when AI_ANDROID_KEYSTORE is set)
AI_ANDROID_KEYSTORE=
ANDROID_KEYSTORE_PATH=
AI_ANDROID_KEYSTORE_PASS=
AI_ANDROID_KEY_ALIAS=
AI_ANDROID_KEY_PASS=
